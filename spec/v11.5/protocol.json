{
  "protocol": "morn",
  "version": "11.5.0",
  "schemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "semanticSlots": [
    "Work",
    "Capability",
    "Authority",
    "ExecutionBinding",
    "Attempt",
    "Receipt",
    "Reconciliation",
    "Outcome",
    "Acceptance",
    "Provenance",
    "Profile"
  ],
  "schemas": {
    "bundle": "./morn-protocol.schema.json",
    "workResource": "./morn-protocol.schema.json#/$defs/WorkResource",
    "capabilityRecord": "./morn-protocol.schema.json#/$defs/CapabilityRecord",
    "executionBinding": "./morn-protocol.schema.json#/$defs/ExecutionBinding",
    "actionAttempt": "./morn-protocol.schema.json#/$defs/ActionAttempt",
    "domainProfile": "./morn-protocol.schema.json#/$defs/DomainProfile",
    "eventEnvelope": "./morn-protocol.schema.json#/$defs/EventEnvelope",
    "authorityDecision": "./morn-protocol.schema.json#/$defs/BoundAuthorityDecision",
    "receipt": "./morn-protocol.schema.json#/$defs/ConnectorReceipt",
    "reconciliation": "./morn-protocol.schema.json#/$defs/ReconciliationRecord",
    "observedOutcome": "./morn-protocol.schema.json#/$defs/ObservedOutcome",
    "acceptanceDecision": "./morn-protocol.schema.json#/$defs/AcceptanceDecision",
    "executionManifest": "./morn-protocol.schema.json#/$defs/ExecutionManifest"
  },
  "examples": {
    "workResource": "./examples/work-resource.json",
    "capabilityRecord": "./examples/capability-record.json",
    "executionBinding": "./examples/execution-binding.json",
    "actionAttempt": "./examples/action-attempt.json",
    "domainProfile": "./examples/factory-profile.json",
    "eventEnvelope": "./examples/event-envelope.json",
    "authorityDecision": "./examples/authority-decision.json",
    "receipt": "./examples/connector-receipt.json",
    "reconciliation": "./examples/reconciliation-record.json",
    "observedOutcome": "./examples/observed-outcome.json",
    "acceptanceDecision": "./examples/acceptance-decision.json",
    "executionManifest": "./examples/execution-manifest.json"
  },
  "invariants": [
    "work-truth-independent-of-executor",
    "workflow-runtime-not-work-truth",
    "active-binding-pinned",
    "profile-effect-gate-before-dispatch",
    "authority-before-restricted-effect",
    "proposal-execution-receipt-outcome-acceptance-distinct",
    "unknown-requires-reconciliation",
    "compiler-not-qualification",
    "qualification-not-admission",
    "profile-version-pinned",
    "history-no-silent-rewrite",
    "profile-guarantees-not-provider-names",
    "evidence-class-explicit"
  ]
}
